# Telegram bot token from @BotFather
BOT_TOKEN=123456:your-bot-token

# SQLite connection string used by Prisma
DATABASE_URL="file:./dev.db"

# Port the Fastify API listens on
PORT=3000

# Origin allowed to call the API (set to your Mini App's deployed origin in production)
CORS_ORIGIN=*

# Public HTTPS URL of the deployed Mini App (enables the WebApp button in the bot)
WEB_APP_URL=

# Link the bot's course warm-up messages point to (external payment/landing page)
COURSE_URL=https://fajr-sestram.ru

# Direct checkout link for the "Ранний подъём" tariff (instant automatic access)
COURSE_PAYMENT_URL=https://monecle.com/buy/96317

# Telegram numeric ID to notify when a course cohort (Идеальное утро / Личные пташки) fills up
ADMIN_TELEGRAM_ID=

# Set to "true" only in local development to bypass Telegram initData signature
# checks via the `x-dev-telegram-id` header. Never enable in production.
ALLOW_DEV_AUTH=false
