generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// A Telegram user of the bot / Mini App.
model User {
  id              String    @id @default(cuid())
  telegramId      String    @unique
  username        String?
  firstName       String?
  // IANA timezone, e.g. "Europe/Moscow". Detected by the Mini App on first open.
  timezone        String    @default("Europe/Moscow")
  // Personal wake-up goal in "HH:MM" local time. Null until onboarding is completed.
  goalTime        String?
  // How many minutes after goalTime a check-in still counts as "on time".
  graceMinutes    Int       @default(45)
  notifyGroup     Boolean   @default(true)
  // Set once the 7-day on-time streak reward (course discount code) has been sent.
  promoUnlockedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  checkIns           CheckIn[]
  memberships        GroupMember[]
  ownedGroups        Group[]             @relation("GroupOwner")
  reminderLogs       ReminderLog[]
  courseDripLogs     CourseDripLog[]
  courseApplications CourseApplication[]
}

// A small accountability group ("друзья/семья") sharing one streak.
model Group {
  id         String   @id @default(cuid())
  name       String
  inviteCode String   @unique
  ownerId    String
  owner      User     @relation("GroupOwner", fields: [ownerId], references: [id])
  createdAt  DateTime @default(now())

  members GroupMember[]
}

model GroupMember {
  id       String   @id @default(cuid())
  groupId  String
  userId   String
  joinedAt DateTime @default(now())

  group Group @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
}

// One check-in per user per local calendar day.
model CheckIn {
  id        String   @id @default(cuid())
  userId    String
  date      String // "YYYY-MM-DD" in the user's local timezone at the moment of check-in
  checkedAt DateTime @default(now())
  onTime    Boolean

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
}

// Tracks which reminders were already sent so the scheduler stays idempotent.
model ReminderLog {
  id     String   @id @default(cuid())
  userId String
  date   String // "YYYY-MM-DD" local day this reminder belongs to
  type   String // "morning" | "lastcall"
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date, type])
}

// Tracks which steps of the course warm-up message sequence were already sent
// to a user, so the scheduler stays idempotent across restarts/overlapping ticks.
model CourseDripLog {
  id     String   @id @default(cuid())
  userId String
  step   Int // index into the warm-up sequence (see scheduler/courseDrip.ts)
  sentAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, step])
}

// A lead for a paid tariff that requires a cohort to fill before it starts
// (see services/courseApplicationService.ts for the thresholds).
model CourseApplication {
  id            String    @id @default(cuid())
  userId        String
  tariff        String // "ideal_morning" | "personal_birds"
  createdAt     DateTime  @default(now())
  // Set on every application in a batch once that batch reaches its threshold.
  groupFilledAt DateTime?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, tariff])
}
